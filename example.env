# Required for HTTP/admin API mode.
AGENT_MAILBOX_ADMIN_TOKEN="change-me"

# HTTP server settings.
# Most deploy platforms set PORT automatically. Leave AGENT_MAILBOX_HTTP_PORT unset
# unless you need to force a local/custom port.
AGENT_MAILBOX_HTTP_HOST="0.0.0.0"
# AGENT_MAILBOX_HTTP_PORT="8137"
AGENT_MAILBOX_HTTP_PATH="/mcp"

# Optional bootstrap access keys. Tokens are hashed into the database on startup.
# AGENT_MAILBOX_HTTP_TOKENS='[
#   {"token":"frontend-secret","agent_id":"frontend-agent","agent_name":"Frontend Agent","workspace":"fullstack"},
#   {"token":"backend-secret","agent_id":"backend-agent","agent_name":"Backend Agent","workspace":"fullstack"}
# ]'

# Database.
# Set DATABASE_URL for Postgres deployments. Omit it to use local SQLite.
DATABASE_URL="${{pg.DATABASE_URL}}"
# AGENT_MAILBOX_DB="/data/local-ai-comms.sqlite"

# S3-compatible artifact storage.
# Omit all of these to keep artifact references only.
AWS_ACCESS_KEY_ID="${{coordinated-saddlebag.ACCESS_KEY_ID}}"
AWS_DEFAULT_REGION="${{coordinated-saddlebag.REGION}}"
AWS_ENDPOINT_URL="${{coordinated-saddlebag.ENDPOINT}}"
AWS_S3_BUCKET_NAME="${{coordinated-saddlebag.BUCKET}}"
AWS_SECRET_ACCESS_KEY="${{coordinated-saddlebag.SECRET_ACCESS_KEY}}"

# CLI identity for local terminal use.
# LOCAL_AI_COMMS_AGENT_ID="codex"
# LOCAL_AI_COMMS_AGENT_NAME="Codex"
# LOCAL_AI_COMMS_WORKSPACE="mcp"
